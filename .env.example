# Database
DATABASE_URL="postgresql://lockerpulse:lockerpulse@localhost:5432/lockerpulse"
POSTGRES_PORT="5432"

# Backend integrations
INPOST_API_BASE_URL="https://api-global-points.easypack24.net/v1"
INPOST_REQUEST_TIMEOUT_SECONDS="10"
NOMINATIM_API_BASE_URL="https://nominatim.openstreetmap.org"
WEB_ORIGIN="http://localhost:3000"

# Frontend
# This value is public and is baked into the Next.js browser bundle at build time.
# Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000"

# Report triage
# Default mode: no model required. Empty REPORT_TRIAGE_MODEL uses deterministic rules.
REPORT_TRIAGE_PROVIDER="auto"
REPORT_TRIAGE_MODEL=""
REPORT_TRIAGE_API_BASE=""
REPORT_TRIAGE_ALLOW_CLOUD_PHOTOS="false"
REPORT_TRIAGE_LOCAL_MODEL_PREFIXES="ollama/,ollama_chat/,local/"
REPORT_TRIAGE_TIMEOUT_SECONDS="60"
REPORT_TRIAGE_PROMPT_VERSION="report-triage-v1"

# Optional local Ollama setup:
# 1. Run: ollama serve
# 2. Run: ollama pull gemma3:4b
# 3. Uncomment:
# REPORT_TRIAGE_PROVIDER="litellm"
# REPORT_TRIAGE_MODEL="ollama_chat/gemma3:4b"
# REPORT_TRIAGE_API_BASE="http://127.0.0.1:11434"

# Optional cloud LiteLLM setup:
# REPORT_TRIAGE_PROVIDER="litellm"
# REPORT_TRIAGE_MODEL="openai/gpt-4o-mini"
# OPENAI_API_KEY="..."
#
# Photos are not sent to cloud models unless this is explicitly true:
# REPORT_TRIAGE_ALLOW_CLOUD_PHOTOS="true"

# Backward-compatible helper for Ollama configs when REPORT_TRIAGE_API_BASE is empty.
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Admin
# Leave empty locally to disable admin auth. Set on Railway.
ADMIN_TOKEN=""
